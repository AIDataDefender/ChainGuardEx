287 [node_type="ast_node", sub_node_type=VariableDeclaration, label="uint8 ratioStart", file="ImpossiblePair.sol", contract=ImpossiblePair, contract_kind=contract, function="", src="1865:23:1", ast_id=323, visibility=public, storage_location=default, function_selector="0fa08747", mutability=mutable, constant=False, state_variable=True, documentation="@dev ratioStart/ratioEnd are hard stops. When ratios of tokens in pools go above\nratioEnd or below ratioStart, trade in the direction that further imbalances\npool is halted. Trades that reduce imbalance will still be allowed.\n@dev This is to control amount of IL faced by LPs on a pool-by-pool basis", type_descriptions="{'type_identifier': 't_uint8', 'type_string': 'uint8'}"];
